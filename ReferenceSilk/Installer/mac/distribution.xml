<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Reference Silk</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plugin" description="For Cubase, Nuendo, Studio One, Ableton Live and other VST3 hosts.">
        <pkg-ref id="com.reference.silk.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plugin" description="For Logic Pro, GarageBand and other AU hosts.">
        <pkg-ref id="com.reference.silk.au"/>
    </choice>
    <pkg-ref id="com.reference.silk.vst3">vst3.pkg</pkg-ref>
    <pkg-ref id="com.reference.silk.au">au.pkg</pkg-ref>
</installer-gui-script>
